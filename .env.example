# ────────────────────────────────────────────────────────────────────────────
# CipherMind AI — Environment Variables
# ────────────────────────────────────────────────────────────────────────────

# Deployer / Oracle private key (without 0x prefix)
PRIVATE_KEY=

# Oracle private key (can be same as PRIVATE_KEY for dev)
ORACLE_PRIVATE_KEY=

# Nous Research / Hermes AI API key
# Get from: https://portal.nousresearch.com
NOUS_API_KEY=
NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=nousresearch/hermes-4-70b

# RPC URLs (optional, defaults are public endpoints)
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ETH_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Contract Addresses (filled after deployment)
CREDIT_CONTRACT_ADDRESS=
TRADING_CONTRACT_ADDRESS=
ANALYTICS_CONTRACT_ADDRESS=
